# ======================================================
# .env.example — کپی کنید به .env.secret و مقادیر واقعی وارد کنید
# این فایل در Git ذخیره می‌شود؛ هیچ secret واقعی اینجا نباشد.
# ======================================================

# ---- Core
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
BOT_MODE=polling
# WEBHOOK_URL=https://yourdomain.com/bot
# WEBHOOK_SECRET=random-secret-string
SUPER_ADMIN_IDS=123456789,987654321

# ---- Database (PostgreSQL)
DB_DRIVER=postgresql+asyncpg
DB_HOST=db
DB_PORT=5432
DB_NAME=opengenerate
DB_USER=og_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Encryption
# حداقل ۳۲ کاراکتر تصادفی — با: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM

# ---- Backup Encryption (اختیاری)
# BACKUP_ENCRYPTION_KEY=another-32-char-key

# ---- Offsite Backup (اختیاری — S3 compatible)
# BACKUP_OFFSITE_ENABLED=true
# BACKUP_OFFSITE_S3_BUCKET=your-bucket
# BACKUP_OFFSITE_S3_KEY=access-key
# BACKUP_OFFSITE_S3_SECRET=secret-key
# BACKUP_OFFSITE_S3_ENDPOINT=https://s3.amazonaws.com

# ---- Scheduler
SCHEDULER_TICK_SECONDS=60
SCHEDULER_MAX_CONCURRENT_CHANNELS=10

# ---- Ports
HEALTH_PORT=9090
METRICS_PORT=9091
